# 复制为 .env 后按需修改（.env 不入库）

# Flask 密钥（生产环境务必替换）
SECRET_KEY=dev-secret-key-change-me

# 微信登录：true=本地 Mock 登录（无需 appid/secret，固定 openid 模拟单一身份）
#           false=真实调用微信 jscode2session
WECHAT_MOCK_LOGIN=true
WECHAT_APPID=
WECHAT_SECRET=

# 上传（头像等）：本地存储目录，默认 instance/uploads（无需改）
# UPLOAD_DIR=
# 对外资源基址（返回给小程序的绝对 URL）；留空则自动取请求 host（本地即 http://127.0.0.1:8000）
# 正式环境需填 HTTPS 域名并加入小程序 request/downloadFile 合法域名
# PUBLIC_BASE_URL=
# 单文件上限（字节），默认 2MB
# MAX_UPLOAD_BYTES=2097152

# 初始管理员（仅当库中无任何管理员时创建；上线后请在管理端改密）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# 支付：mock=本地模拟(即时成功，仅开发)；wechat=微信商户支付 v3。**生产必须 wechat**
PAYMENT_PROVIDER=mock
# 以下 PAYMENT_PROVIDER=wechat 时必填；appid 复用上面 WECHAT_APPID
# WXPAY_MCHID=1900000001
# WXPAY_APIV3_KEY=你的32位APIv3密钥
# WXPAY_CERT_SERIAL_NO=商户证书序列号
# WXPAY_PRIVATE_KEY_PATH=instance/apiclient_key.pem   # 商户API私钥文件路径
# WXPAY_NOTIFY_URL=https://your-domain/api/v1/client/payments/notify
# 平台证书目录（留空自动下载到 instance/wxcert）；或用微信支付公钥模式：
# WXPAY_CERT_DIR=
# WXPAY_PUBLIC_KEY_PATH=
# WXPAY_PUBLIC_KEY_ID=

# 图床：local=本地磁盘；oss=阿里云 OSS（Bucket 需公共读）
IMAGE_PROVIDER=local
# IMAGE_PROVIDER=oss 时必填：
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=你的bucket名
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 可选：绑定自定义域名后填（如 https://img.yourdomain.com）；留空用 OSS 默认 https 域名
# OSS_PUBLIC_BASE=

# 企业微信群机器人 webhook（新订单/退款申请通知）；留空则不推送
WECOM_WEBHOOK_URL=
# 通知总开关（默认 true）；本地开发/跑冒烟测试请设为 false，避免往真实群里刷测试消息
WECOM_NOTIFY_ENABLED=true
